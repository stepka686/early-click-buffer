{
  "geode": "5.11.2",
  "gd": {
    "android": "2.2081"
  },
  "id": "earlyclick.buffer",
  "name": "Early Click Buffer",
  "version": "v1.0.0",
  "developer": "EarlyClickDev",
  "description": "Configurable input buffer for Geometry Dash.",
  "tags": [
    "gameplay",
    "utility"
  ],
  "settings": {
    "enabled": {
      "name": "Enable Input Buffer",
      "type": "bool",
      "default": true
    },
    "delay": {
      "name": "Buffer Delay",
      "description": "Input delay in frames",
      "type": "int",
      "default": 2,
      "min": 1,
      "max": 4
    }
  }
}
